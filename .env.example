# Carpoolr local development environment
# Copy to .env (project root) and adjust:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# --- PostgreSQL (used by db/docker-compose.yml via `make db-up`) ---
POSTGRES_USER=carpoolr
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=carpoolr

# Host port for PostgreSQL. Override if 5432 is already in use.
# NOTE: if you change this, also update Port= in ConnectionStrings__Default
# below — the API connects to the host port, not the in-container one.
POSTGRES_PORT=5432

# --- API (apps/api) ---
# The .NET BFF reads this from its process environment (double underscore = config hierarchy).
# ASP.NET Core does not load this file automatically; export the value or use
# dotnet user-secrets as described in docs/grpc-trips.md before calling TripService.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=carpoolr;Username=carpoolr;Password=change-me-local-only

# Required outside Development; provide the real values through deployment configuration.
# Authentication__Authority=https://auth.splashmich.net/application/o/<actual-application-slug>/
# Authentication__Audience=<actual-access-token-audience>
#
# Optional server-side Authentik login (disabled until the provider is configured).
# Use User Secrets / Kubernetes Secrets for ClientSecret, never this example or Git.
# Both frontend and API must use this same HTTPS public origin, with API under /api.
# DemoMode__Enabled=false
# Authentication__Browser__Enabled=true
# Authentication__Browser__ClientId=<actual-confidential-client-id>
# Authentication__Browser__PublicOrigin=https://carpoolr.staging.splashmich.net
# Authentication__Browser__DataProtectionKeysPath=/var/lib/carpoolr/authentication-keys
# Setup and Kubernetes activation: docs/authentication.md

# --- Web (apps/web) ---
# Base URL the frontend uses to reach the BFF (direct fetch, CORS — no dev proxy).
VITE_API_BASE_URL=http://localhost:5000
