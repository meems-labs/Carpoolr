<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>carpoolr-api-development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.84.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/trips/v1/trips.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK publishes JSON by default; local HTTP-client credentials must stay local. -->
    <Content Update="**/http-client*.env.json;**/secrets*.json"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="Never" />
    <None Update="**/http-client*.env.json;**/secrets*.json"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
